# Copy to the project root as `.env` and fill in real values.
#   cp config/.env.example .env

DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_MODEL="deepseek-chat" # or "deepseek-reasoner"

# Optional overrides (leave blank to use config/settings.yaml)
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Optional alerting channels (leave blank to disable)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
WEBHOOK_URL=""
